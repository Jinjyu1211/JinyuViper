<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>Jinyu</AssemblyName>
    <RootNamespace>Jinyu</RootNamespace>
    <Version>1.0.0.0</Version>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <PromeRotationInstallRoot>$(APPDATA)\XIVLauncherCN\installedPlugins\PromeRotation</PromeRotationInstallRoot>
    <PromeRotationDir Condition="'$(PromeRotationDir)' == ''">$([System.IO.Directory]::GetDirectories('$(PromeRotationInstallRoot)')[0])</PromeRotationDir>
    <DalamudPath>$(APPDATA)\XIVLauncherCN\addon\Hooks\dev</DalamudPath>
    <OutputPath>$(APPDATA)\XIVLauncherCN\pluginConfigs\PromeRotation\ACR\Jinyu\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="**\*.cs" Exclude="obj\**;bin\**;tools\**" />
    <Reference Include="Dalamud;Dalamud.Bindings.ImGui;FFXIVClientStructs;InteropGenerator.Runtime;Lumina;Lumina.Excel">
      <HintPath>$(DalamudPath)\%(Identity).dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="PromeRotation;ECommons">
      <HintPath>$(PromeRotationDir)\%(Identity).dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
